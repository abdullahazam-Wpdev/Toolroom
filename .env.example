NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://toolroom:development-only@localhost:5432/toolroom
REDIS_URL=redis://localhost:6379
# Future server-side integration; never NEXT_PUBLIC_
PAGESPEED_API_KEY=
BACKGROUND_REMOVAL_WORKER_URL=
UPSCALER_WORKER_URL=

# Configure apps/web/.env.local for the Next.js application. Never expose keys as NEXT_PUBLIC_.
SEMRUSH_ENABLED=false
SEMRUSH_API_KEY=
SEMRUSH_DAILY_UNIT_BUDGET=200
PEXELS_API_KEY=
# Live AdSense remains off pending account approval, ad-unit IDs and a reviewed CMP integration.

# Persistent media jobs: web and worker must share the same absolute storage directory.
MEDIA_JOBS_ENABLED=false
JOB_STORAGE_DIR=/absolute/path/to/toolroom/.runtime/jobs
MODEL_STORAGE_DIR=/absolute/path/to/toolroom/.runtime/models
AI_PYTHON=/absolute/path/to/toolroom/.runtime/ai-venv/bin/python3

# Production canonical origin (set at BUILD time and runtime; redeploy after changing).
# NEXT_PUBLIC_SITE_URL=https://toolroom-woad.vercel.app
CRAWL_JOBS_ENABLED=false
# Private S3/R2 bucket. Keep unset until bucket CORS/lifecycle/cleanup are configured.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_SIGNING_SECRET=
CRON_SECRET=
OPERATOR_HEALTH_SECRET=
# Optional operator-controlled exact additional UI origins, comma separated.
APP_ALLOWED_ORIGINS=

    {
      "step_id": "submit",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Analyze"
      },
      "timeout_ms": 5000
    }
  ],
  "capture": {
    "at_end": [
      "url",
      "dom",
      "accessibility"
    ]
  }
